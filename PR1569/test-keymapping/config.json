{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v3.0.0/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Test Keymapper",
    "version": "pilot",
    "authors": [
      "The reVISit Team"
    ],
    "date": "2026-02-23",
    "description": "Manual tests for button keymapping, auto-advance, previous navigation, validation, and feedback.",
    "organizations": [
      "University of Utah",
      "WPI"
    ]
  },
  "uiConfig": {
    "contactEmail": "contact@revisit.dev",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": false,
    "urlParticipantIdParam": "PROLIFIC_PID",
    "studyEndMsg": "**Thank you for completing the study. You may click this link and return to Prolific**: [yourProlificLink](yourProlificLink)"
  },
  "components": {
    "auto-advance-keymapper": {
      "type": "questionnaire",
      "instruction": "Press J or K. The selection locks, then advances after one second. Next remains visible here so you can continue after using Previous.",
      "showNextButtonOnAutoAdvance": true,
      "response": [
        {
          "id": "auto-key-response",
          "type": "buttons",
          "prompt": "Choose with a mapped key",
          "options": [
            { "label": "Left (J)", "value": "left", "key": "j" },
            { "label": "Right (K)", "value": "right", "key": "k" }
          ],
          "autoAdvanceToNextStep": true,
          "autoAdvanceDelay": 1000,
          "allowResponseChange": false
        }
      ]
    },
    "auto-advance-change": {
      "type": "questionnaire",
      "previousButton": true,
      "instruction": "Press A, B, or C. You can change your answer during the three-second delay; each change restarts it. To test a pending delay, select an option and immediately click Previous. When you return, your draft answer is retained, but Next stays hidden. Select an option again to restart the delay.",
      "response": [
        {
          "id": "change-response",
          "type": "buttons",
          "location": "aboveStimulus",
          "prompt": "Change your answer before it advances",
          "options": [
            { "label": "A", "value": "a", "key": "a" },
            { "label": "B", "value": "b", "key": "b" },
            { "label": "C", "value": "c", "key": "c" }
          ],
          "autoAdvanceToNextStep": true,
          "autoAdvanceDelay": 3000,
          "allowResponseChange": true
        }
      ]
    },
    "auto-advance-required-validation": {
      "type": "questionnaire",
      "previousButton": true,
      "instruction": "First choose with 1 or 2 and wait for the required-field error. Then enter text and choose the other button to retry. This deliberately triggers the multi-question configuration warning.",
      "response": [
        {
          "id": "required-edge-choice",
          "type": "buttons",
          "prompt": "Choose with a mapped key",
          "options": [
            { "label": "First (1)", "value": "first", "key": "1" },
            { "label": "Second (2)", "value": "second", "key": "2" }
          ],
          "autoAdvanceToNextStep": true,
          "autoAdvanceDelay": 500,
          "allowResponseChange": true
        },
        {
          "id": "required-edge-text",
          "type": "shortText",
          "prompt": "Required before continuing",
          "required": true
        }
      ]
    },
    "auto-advance-math-quiz": {
      "type": "questionnaire",
      "previousButton": true,
      "provideFeedback": true,
      "hideCheckAnswerButton": true,
      "trainingAttempts": 1,
      "allowFailedTraining": true,
      "instruction": "Choose an answer with 1, 2, or 3. You get one attempt. Feedback is shown before the study advances.",
      "response": [
        {
          "id": "math-response",
          "type": "buttons",
          "prompt": "What is 7 × 8?",
          "options": [
            { "label": "54", "value": "54", "key": "1" },
            { "label": "56", "value": "56", "key": "2" },
            { "label": "58", "value": "58", "key": "3" }
          ],
          "autoAdvanceToNextStep": true,
          "autoAdvanceDelay": 300,
          "allowResponseChange": false
        }
      ],
      "correctAnswer": [
        {
          "id": "math-response",
          "answer": "56",
          "feedback": {
            "correctText": "Correct.",
            "incorrectText": "you should have learned that in school"
          }
        }
      ]
    },
    "letter-mapper":{
      "response": [
        {
          "id": "letter-response",
          "type": "buttons",
          "prompt": "Pick a letter",
          "location": "belowStimulus",
          "options": [
            { "label": "A", "value": "a", "key": "a" },
            { "label": "S", "value": "s", "key": "s" },
            { "label": "D", "value": "d", "key": "d" },
            { "label": "F", "value": "f", "key": "f" },
            { "label": "shift+r", "value": "shift+r", "key": "shift+r" }
          ]
        },
        {
          "id": "number-response",
          "type": "buttons",
          "prompt": "Pick a number",
          "location": "belowStimulus",
          "options": [
            { "label": "1", "value": "1", "key": "1" },
            { "label": "2", "value": "2", "key": "2" },
            { "label": "3", "value": "3", "key": "3" },
            { "label": "4", "value": "4", "key": "4" },
          ]
        }
      ],
      "type": "questionnaire",
      "nextOnEnter": true
    },
    "special-mapper":{
      "response": [
        {
          "id": "letter-response",
          "type": "buttons",
          "prompt": "Indicate correlation direction",
          "location": "belowStimulus",
          "options": [
            { "label": "Left", "value": "arrowleft", "key": "ArrowLeft" },
            { "label": "Right", "value": "ArrowRight", "key": "ArrowRight" },
            { "label": "Up", "value": "ARROWUP", "key": "ArrowUp" },
            { "label": "Down", "value": "arrowDown", "key": "ArrowDown" },
            { "label": "Space", "value": "space", "key": "Space" }
          ]
        }],
      "type": "questionnaire",
      "nextOnEnter": true
    }
  },
    "sequence": {
    "order": "fixed",
    "components": [
      "auto-advance-keymapper",
      "auto-advance-change",
      "auto-advance-required-validation",
      "auto-advance-math-quiz",
      "special-mapper",
      "letter-mapper"
    ]
  }
}
