{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.4/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Test Likert and Matrix Responses",
    "version": "pilot",
    "authors": [
      "The reVISit Team"
    ],
    "date": "2026-02-23",
    "description": "A test of Likert and matrix responses.",
    "organizations": [
      "University of Utah",
      "WPI"
    ]
  },
  "uiConfig": {
    "contactEmail": "contact@revisit.dev",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": true,
    "urlParticipantIdParam": "PROLIFIC_PID",
    "studyEndMsg": "**Thank you for completing the study. You may click this link and return to Prolific**: [yourProlificLink](yourProlificLink)"
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "likert-component"
    ]
  },
  "components": {
    "likert-component": {
      "response": [
        {
          "id": "my_likert",
          "prompt": "How likely would you be to own each of the following pets?",
          "secondaryText": "1 = Highly Unlikely, 5 = Highly Likely",
          "location": "aboveStimulus",
          "type": "matrix-radio",
          "answerOptions": "likely5",
          "questionOptions": [
            "Cat",
            "Dog",
            "Rat",
            "Horse",
            "Sentient Robot"
          ]
        },
        {
          "id": "additional_likert",
          "prompt": "For each animal, select all that apply.",
          "location": "aboveStimulus",
          "type": "matrix-checkbox",
          "answerOptions": [
            "I've never seen that animal",
            "I've never owned one.",
            "I know somebody who owns this type of animal",
            "I owned one when I was a child.",
            "I own one now"
          ],
          "questionOptions": [
            "Cat",
            "Dog",
            "Rat",
            "Horse",
            "Sentient Robot"
          ]
        },
        {
          "id": "q1",
          "prompt": "How useful did you find the rectangular selection method?",
          "location": "aboveStimulus",
          "type": "likert",
          "numItems": 7,
          "rightLabel": "Very useful",
          "leftLabel": "Not useful"
        }
      ],
      "type": "questionnaire"
    }
  }
}
