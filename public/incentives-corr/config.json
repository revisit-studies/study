{
  "$schema": "../../src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Correlation Judgement with Visualizations",
    "version": "pilot",
    "authors": [
      "Abhraneel Sarma"
    ],
    "date": "2026-02-08",
    "description": "A factorized correlation-judgement study that counterbalances incentive and visualization conditions while composing training and test trials from correlation parameters.",
    "externalLink": "https://arxiv.org/abs/2607.07463",
    "organizations": [
      "Graz University of Technology"
    ]
  },
  "uiConfig": {
    "contactEmail": "asarma@tugraz.at",
    "helpTextPath": "incentives-corr/assets/help.md",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": true,
    "urlParticipantIdParam": "PROLIFIC_PID",
    "participantNameField": "introduction.prolificId",
    "studyEndMsg": "Thank you for completing the study! Please wait while we automatically redirect you to Prolific. Or you can click on this [link](https://app.prolific.com/submissions/complete?cc=C1PEMLO4)",
    "studyEndAutoRedirectURL": "https://app.prolific.com/submissions/complete?cc=C1PEMLO4",
    "studyEndAutoRedirectDelay": 10000
  },
  "factors": {
    "incentive": [
      "base",
      "inc"
    ],
    "vis": [
      "pcp",
      "scatter"
    ],
    "r1": [
      0.3,
      0.4,
      0.5,
      0.6,
      0.7
    ],
    "delta": [
      0.03,
      0.04,
      0.05,
      0.06,
      0.07,
      0.08,
      0.09,
      0.1,
      0.12,
      0.14,
      0.18,
      0.22,
      0.26
    ],
    "r1Training": [
      0.3,
      0.9,
      0.6,
      0.6,
      0.3,
      0.5,
      0.9,
      0.6,
      0.99
    ],
    "r2Training": [
      0.7,
      0.6,
      0.3,
      0.9,
      0.1,
      0.3,
      0.8,
      0.7,
      0.9
    ],
    "trainingPairs": {
      "action": "zip",
      "factors": [
        "r1Training",
        "r2Training"
      ]
    },
    "testTrials": {
      "action": "cross",
      "factors": [
        "r1",
        "delta"
      ]
    }
  },
  "baseComponents": {
    "practice": {
      "type": "react-component",
      "path": "incentives-corr/assets/Practice.tsx",
      "stylesheetPath": "incentives-corr/assets/task.css",
      "helpTextPath": "incentives-corr/assets/help-@vis.md",
      "response": [
        {
          "id": "training",
          "prompt": "",
          "required": true,
          "type": "reactive",
          "location": "belowStimulus"
        }
      ],
      "correctAnswer": [
        {
          "id": "training",
          "answer": true
        }
      ]
    },
    "test": {
      "type": "react-component",
      "path": "incentives-corr/assets/Task.tsx",
      "parameters": {
        "taskid": "test"
      },
      "stylesheetPath": "incentives-corr/assets/task.css",
      "helpTextPath": "incentives-corr/assets/help-@vis.md",
      "response": [
        {
          "id": "test",
          "prompt": "",
          "required": true,
          "type": "buttons",
          "options": [
            "false",
            "true"
          ],
          "location": "belowStimulus",
          "hidden": true
        }
      ],
      "correctAnswer": [
        {
          "id": "test",
          "answer": true
        }
      ]
    },
    "summary": {
      "type": "react-component",
      "path": "incentives-corr/assets/Summary.tsx",
      "response": []
    }
  },
  "components": {
    "tutorial": {
      "type": "markdown",
      "path": "incentives-corr/assets/02-tutorial-@vis.md",
      "response": []
    },
    "introduction": {
      "type": "markdown",
      "path": "incentives-corr/assets/00-intro-@incentive.md",
      "response": [
        {
          "id": "prolificId",
          "prompt": "Prolific ID:",
          "required": false,
          "location": "belowStimulus",
          "type": "shortText",
          "paramCapture": "PROLIFIC_PID",
          "placeholder": "Prolific ID"
        }
      ]
    },
    "consent": {
      "type": "markdown",
      "path": "incentives-corr/assets/01-consent-@incentive.md",
      "previousButton": true,
      "previousButtonText": "Back",
      "response": [
        {
          "id": "consentApproval",
          "prompt": "By clicking on 'Yes' below, you indicate that you have understood the Information Sheet and agree to participate in this study.",
          "type": "radio",
          "options": [
            "Yes",
            "No"
          ]
        }
      ]
    },
    "task-details": {
      "type": "markdown",
      "path": "incentives-corr/assets/04-instructions-@incentive.md",
      "response": []
    },
    "attention-1": {
      "baseComponent": "test",
      "parameters": {
        "taskid": "attention",
        "attentionIndex": 1,
        "r1": 0.01,
        "r2": 0.99
      }
    },
    "attention-2": {
      "baseComponent": "test",
      "parameters": {
        "taskid": "attention",
        "attentionIndex": 2,
        "r1": 0.01,
        "r2": 0.99
      }
    },
    "attention-3": {
      "baseComponent": "test",
      "parameters": {
        "taskid": "attention",
        "attentionIndex": 3,
        "r1": 0.01,
        "r2": 0.99
      }
    },
    "attention-4": {
      "baseComponent": "test",
      "parameters": {
        "taskid": "attention",
        "attentionIndex": 4,
        "r1": 0.01,
        "r2": 0.99
      }
    },
    "attention-5": {
      "baseComponent": "test",
      "parameters": {
        "taskid": "attention",
        "attentionIndex": 5,
        "r1": 0.01,
        "r2": 0.99
      }
    }
  },
  "betweenSubjects": [
    "incentive",
    "vis"
  ],
  "sequence": {
    "order": "fixed",
    "components": [
      "introduction",
      "consent",
      "tutorial",
      {
        "type": "factor",
        "id": "training",
        "factor": "trainingPairs",
        "components": "practice",
        "order": "random"
      },
      "task-details",
      {
        "type": "factor",
        "id": "test",
        "factor": "testTrials",
        "order": "latinSquare",
        "components": "test",
        "interruptions": [
          {
            "spacing": "random",
            "numInterruptions": 1,
            "components": [
              "attention-1"
            ]
          },
          {
            "spacing": "random",
            "numInterruptions": 1,
            "components": [
              "attention-2"
            ]
          },
          {
            "spacing": "random",
            "numInterruptions": 1,
            "components": [
              "attention-3"
            ]
          },
          {
            "spacing": "random",
            "numInterruptions": 1,
            "components": [
              "attention-4"
            ]
          },
          {
            "spacing": "random",
            "numInterruptions": 1,
            "components": [
              "attention-5"
            ]
          }
        ]
      }
    ]
  }
}
