{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.3/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Test for parser errors",
    "version": "pilot",
    "authors": [
      "The reVISit Team"
    ],
    "date": "2026-02-23",
    "description": "This is a test for parser errors.",
    "organizations": [
      "University of Utah",
      "WPI"
    ]
  },
  "uiConfig": {
    "contactEmail": "contact@revisit.dev",
    "helpTextPath": "",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": false,
    "windowEventDebounceTime": 200
  },
  "importedLibraries": [
    "test",
    "test-missing"
  ],
  "baseComponents": {
    "testBaseComponent": {
      "type": "markdown",
      "path": "test-parser-errors/assets/md1.md",
      "response": []
    }
  },
  "components": {
    "md1": {
      "type": "markdown",
      "path": "test-parser-errors/assets/md1.md",
      "response": []
    },
    "md2": {
      "type": "markdown",
      "path": "test-parser-errors/assets/md1.md",
      "response": []
    },
    "missingBaseComponent": {
      "baseComponent": "missingBaseComponent"
    },
    "workingBaseComponentFromLibrary": {
      "baseComponent": "$test.components.test-md"
    },
    "missingComponentFromLibrary": {
      "baseComponent": "$test.components.test-missing"
    },
    "testComponent": {
      "type": "markdown",
      "path": "test-parser-errors/assets/md1.md",
      "response": []
    },
    "sidebarComponent": {
      "type": "markdown",
      "path": "test-parser-errors/assets/md1.md",
      "instructionLocation": "sidebar",
      "withSidebar": false,
      "response": []
    },
    "sidebarUiConfig": {
      "type": "markdown",
      "path": "test-parser-errors/assets/md1.md",
      "instructionLocation": "sidebar",
      "response": []
    },
    "color-mapper": {
      "response": [
        {
          "id": "color-response",
          "type": "buttons",
          "prompt": "Select the ink color",
          "location": "belowStimulus",
          "options": [
            { "label": "RED", "value": "red", "key": "r" },
            { "label": "ORANGE", "value": "orange", "key": "u" },
            { "label": "YELLOW", "value": "yellow", "key": "t" },
            { "label": "GREEN", "value": "green", "key": "w" },
            { "label": "BLUE", "value": "blue", "key": "q" }
          ]
        },
        {
          "id": "color-response2",
          "type": "buttons",
          "prompt": "Select the ink color",
          "location": "belowStimulus",
          "options": [
            { "label": "RED", "value": "red", "key": "r" },
            { "label": "ORANGE", "value": "orange", "key": "o" },
            { "label": "YELLOW", "value": "yellow", "key": "y" },
            { "label": "GREEN", "value": "green", "key": "g" },
            { "label": "BLUE", "value": "blue", "key": "b" }
          ],
          "hideKeyVisual": true
        }],
      "type": "questionnaire",
      "nextOnEnter": true
    },
    "math-mapper":{
      "response": [
        {
          "id": "letter-response",
          "type": "buttons",
          "prompt": "What is 10+4",
          "location": "belowStimulus",
          "options": [
            { "label": "14", "value": "14", "key": "14" },
            { "label": "1", "value": "1", "key": "1" },
            { "label": "4", "value": "4", "key": "4" }
          ]
        }],
      "type": "questionnaire"
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "md1",
      "missingComponent",
      "testBaseComponent",
      "sidebarComponent",
      "sidebarUiConfig",
      {
        "order": "fixed",
        "components": [
          "nestedMissingComponent"
        ],
        "skip": [
          {
            "check": "block",
            "condition": "numCorrect",
            "value": 1,
            "to": "md1"
          }
        ]
      },
      {
        "order": "fixed",
        "components": [
          "md2"
        ],
        "skip": [
          {
            "check": "block",
            "condition": "numCorrect",
            "value": 1,
            "to": "md2"
          }
        ]
      },
      {
        "order": "fixed",
        "components": []
      },
      "md2",
      "$test.sequences.small",
      "$test.sequences.long",
      "$test.components.test-md",
      "$test.components.test-react",
      "$test.components.test-missing",
      "$test.sequences.missingSequence",
      "missingBaseComponent",
      "workingBaseComponentFromLibrary",
      "missingComponentFromLibrary",
      "color-mapper",
      "math-mapper"
    ]
  }
}
