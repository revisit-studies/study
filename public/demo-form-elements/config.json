    "Form Elements": {
      "type": "questionnaire",
      "response": [
        {
          "id": "title",
          "type": "textOnly",
          "prompt": "# Form Elements\n\n This page shows many of the form elements that are supported in reVISit.",
          "restartEnumeration": true
        },
        {
          "id": "textFieldDemo",
          "type": "textOnly",
          "prompt": "## This is a level 2 text header\n\n ### This is a level 3 subheader\n\n You can use text fields with markdown headings to structure your survey. You can make it **bold** or *italic*. You can also add links like [this](https://revisit.dev). Markdown also works in question prompts and secondary text."
        },
        {
          "id": "numericalInputTitle",
          "type": "textOnly",
          "prompt": "## Numerical Inputs",
          "restartEnumeration": true
        },
        {
          "id": "q-numerical",
          "prompt": "Numerical example",
          "secondaryText": "A numeric example that is required to complete and has an option to say 'Don't know'.",
          "infoText": "This numerical input accepts values between 0 and 100.",
          "type": "numerical",
          "placeholder": "Enter your age here, range from 0 to 100",
          "max": 100,
          "min": 0,
          "withDontKnow": true
        },
        {
          "id": "q-slider",
          "prompt": "Slider example",
          "secondaryText": "A slider for 0-100 with 3 breakpoints for bad, mid, and good",
          "infoText": "Use the slider to indicate your rating on a scale from 'Bad' to 'Good'.",
          "type": "slider",
          "startingValue": 50,
          "spacing": 50,
          "options": [
            {
              "label": "Bad",
              "value": 0
            },
            {
              "label": "Mid",
              "value": 50
            },
            {
              "label": "Good",
              "value": 100
            }
          ]
        },
        {
          "id": "textInputTitle",
          "type": "textOnly",
          "prompt": "## Text Inputs",
          "restartEnumeration": true
        },
        {
          "id": "q-short-text",
          "prompt": "Short text example",
          "secondaryText": "A short text example",
          "infoText": "Your response can be a few words or a short sentence.",
          "type": "shortText",
          "placeholder": "Enter your answer here"
        },
        {
          "id": "q-long-text",
          "prompt": "Long text example",
          "secondaryText": "A text box for long text",
          "infoText": "Your response can be a detailed explanation or multiple sentences.",
          "type": "longText",
          "placeholder": "Enter your long comments here"
        },
        {
          "id": "radioInputTitle",
          "type": "textOnly",
          "prompt": "## Dropdowns, Radios, Checkboxes and Buttons",
          "restartEnumeration": true
        },
        {
          "id": "q-dropdown",
          "prompt": "Dropdown example – which chart do you like best?",
          "secondaryText": "You can specify secondary text to clarify your question.",
          "infoText": "Select the chart type you prefer from the dropdown menu.",
          "type": "dropdown",
          "placeholder": "Enter your preference",
          "options": [
            {
              "label": "Bar",
              "infoText": "A bar chart is useful for comparing values across categories."
            },
            "Bubble",
            "Pie",
            "Stacked Bar"
          ]
        },
        {
          "id": "q-multiselect-dropdown",
          "prompt": "Multiselect dropdown example - which charts have you used before?",
          "secondaryText": "Dropdown for multi-selection",
          "infoText": "Select the chart types you have used before. You have to select at least 2 options and up to 3 options.",
          "type": "dropdown",
          "placeholder": "Enter your responses",
          "options": [
            "Bar",
            "Bubble",
            "Pie",
            "Stacked Bar",
            {
              "label": "Line",
              "infoText": "A line chart is commonly used for trends over time."
            },
            "Scatter",
            "Histogram"
          ],
          "minSelections": 2,
          "maxSelections": 3
        },
        {
          "id": "q-country-dropdown",
          "prompt": "Country dropdown example",
          "type": "dropdown",
          "options": "countries"
        },
        {
          "id": "q-checkbox",
          "prompt": "Checkbox example, but this time with a long title that makes a ton of sense and is really cool",
          "secondaryText": "Checkboxes for multi-selection",
          "infoText": "Select your top 2 choices from the available options.",
          "minSelections": 2,
          "maxSelections": 2,
          "type": "checkbox",
          "options": [
            "Option 1",
            "Option 2",
            "Option 3"
          ],
          "withOther": true
        },
        {
          "id": "q-checkbox-horizontal",
          "prompt": "Horizontal Checkbox example, but this time with a long title that makes a ton of sense and is really cool",
          "secondaryText": "Checkboxes for multi-selection",
          "infoText": "Select your top 2 choices from the available options.",
          "minSelections": 2,
          "maxSelections": 2,
          "type": "checkbox",
          "options": [
            "Option 1",
            "Option 2",
            "Option 3"
          ],
          "horizontal": true,
          "withOther": true
        },
        {
          "id": "q-radio",
          "prompt": "Radio button example",
          "secondaryText": "Radio buttons for single selection",
          "infoText": "Select the option that best represents your choice.",
          "type": "radio",
          "options": [
            {
              "label": "Option 1",
              "infoText": "This is info text for Option 1."
            },
            {
              "label": "Option 2",
              "value": "Option 2"
            }
          ],
          "withOther": true
        },
        {
          "id": "q-radio-horizontal",
          "prompt": "Horizontal Radio button example",
          "secondaryText": "Radio buttons for single selection",
          "infoText": "Select the option that best represents your choice.",
          "type": "radio",
          "options": [
            "Option 1",
            "Option 2 is a long option that will wrap"
          ],
          "horizontal": true,
          "withOther": true
        },
        {
          "id": "q-buttons",
          "type": "buttons",
          "prompt": "Buttons example",
          "secondaryText": "Buttons that function as radio buttons, but look like buttons. Control with the arrow keys.",
          "infoText": "Choose the option that best represents your answer.",
          "options": [
            {
              "label": "Option 1",
              "infoText": "This is info text for button option 1."
            },
            "Option 2",
            "Option 3",
            "Option 4"
          ]
        },
        {
          "id": "divider1",
          "type": "divider"
        },
        {
          "id": "matrixHeaderTitle",
          "type": "textOnly",
          "prompt": "## Likert Scales and Matrix Form Elements\n\n Matrix form elements allow you to ask a series of related questions that share the same set of answer options. This is useful for Likert scales, satisfaction ratings, and categorization tasks.",
          "restartEnumeration": true
        },
        {
          "id": "q-likert",
          "prompt": "Likert scale example",
          "secondaryText": "A Likert example with 9 items, also showing how to add a divider after the element.",
          "infoText": "This is a 9-point Likert scale from 'Dislike' to 'Like'. Select the number that best represents your opinion.",
          "type": "likert",
          "numItems": 9,
          "rightLabel": "Like",
          "leftLabel": "Dislike"
        },
        {
          "id": "divider2",
          "type": "divider"
        },
        {
          "id": "q-multi-satisfaction",
          "prompt": "Rate your satisfaction from 1 (Highly Unsatisfied) to 5 (Highly Satisfied) for the following items.",
          "secondaryText": "A simple matrix of Likert responses with predefined options for satisfaction.",
          "infoText": "This is a matrix radio where you rate each item on a 5-point scale from 'Highly Unsatisfied' to 'Highly Satisfied'.",
          "type": "matrix-radio",
          "answerOptions": "satisfaction5",
          "questionOptions": [
            "The tool we created",
            "The technique we developed",
            "The authors of the tools"
          ]
        },
        {
          "id": "multi-custom",
          "prompt": "Which categories do the following items belong to?",
          "secondaryText": "A matrix of checkboxes with custom options for categorization.",
          "infoText": "For each animal, select all the categories that apply. You can select multiple checkboxes per row.",
          "type": "matrix-checkbox",
          "answerOptions": [
            {
              "label": "Has Legs",
              "infoText": "Use this when the animal has legs."
            },
            {
              "label": "Has Wings",
              "infoText": "Use this when the animal has wings."
            },
            {
              "label": "Can Swim",
              "infoText": "Use this when the animal can swim."
            }
          ],
          "questionOptions": [
            "Dog",
            {
              "label": "Snake",
              "infoText": "Snakes do not have legs."
            },
            {
              "label": "Eagle",
              "infoText": "Eagles are birds with wings."
            },
            {
              "label": "Salmon",
              "infoText": "Salmon can swim."
            },
            "Platypus"
          ]
        }
      ]
    },
    "Text Validation": {
      "type": "questionnaire",
      "response": [
        {
          "id": "text-validation-title",
          "type": "textOnly",
          "prompt": "# Text Validation\n\nThis page demonstrates validation rules for short and long text responses. Enter a value that satisfies each instruction, then continue to see how the rules are validated. For help writing regular expression patterns, see the [MDN regular expression syntax cheat sheet](https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_expressions/Cheatsheet).",
          "restartEnumeration": true
        },
        {
          "id": "text-validation-regex",
          "type": "shortText",
          "prompt": "Enter a code with three uppercase letters, a hyphen, and three digits.",
          "secondaryText": "For example: ABC-123. This response uses matchesRegex with the pattern ^[A-Z]{3}-\\d{3}$.",
          "placeholder": "ABC-123",
          "textValidation": [
            {
              "type": "matchesRegex",
              "value": "^[A-Z]{3}-\\d{3}$"
            }
          ]
        },
        {
          "id": "text-validation-contains",
          "type": "shortText",
          "prompt": "Enter a short response that contains the exact text “ReVISit”.",
          "secondaryText": "The contains validation is case-sensitive.",
          "placeholder": "I use ReVISit for...",
          "textValidation": [
            {
              "type": "contains",
              "value": "ReVISit"
            }
          ]
        },
        {
          "id": "text-validation-does-not-contain",
          "type": "longText",
          "prompt": "Enter a sentence that does not contain the exact lowercase text “invalid”.",
          "secondaryText": "This long text response uses doesNotContain and is case-sensitive.",
          "placeholder": "Describe a valid response...",
          "textValidation": [
            {
              "type": "doesNotContain",
              "value": "invalid"
            }
          ]
        },
        {
          "id": "text-validation-equals",
          "type": "shortText",
          "prompt": "Enter exactly “ReVISit”.",
          "secondaryText": "This response uses equals and is case-sensitive.",
          "placeholder": "ReVISit",
          "textValidation": [
            {
              "type": "equals",
              "value": "ReVISit"
            }
          ]
        },
        {
          "id": "text-validation-does-not-equal",
          "type": "longText",
          "prompt": "Enter any response except the exact text “TEST”.",
          "secondaryText": "This response uses doesNotEqual and is case-sensitive.",
          "placeholder": "Anything except TEST",
          "textValidation": [
            {
              "type": "doesNotEqual",
              "value": "TEST"
            }
          ]
        },
        {
          "id": "character-length-title",
          "type": "textOnly",
          "prompt": "## Character Length\n\nShort and long text responses can require a minimum number of characters, a maximum number of characters, or both.",
          "restartEnumeration": true
        },
        {
          "id": "character-length-short",
          "type": "shortText",
          "prompt": "Enter between 3 and 10 characters.",
          "secondaryText": "This short text response uses minCharLength: 3 and maxCharLength: 10.",
          "placeholder": "3–10 characters",
          "minCharLength": 3,
          "maxCharLength": 10
        },
        {
          "id": "character-length-long",
          "type": "longText",
          "prompt": "Enter between 20 and 100 characters.",
          "secondaryText": "This long text response uses minCharLength: 20 and maxCharLength: 100.",
          "placeholder": "20–100 characters",
          "minCharLength": 20,
          "maxCharLength": 100
        },
        {
          "id": "word-length-title",
          "type": "textOnly",
          "prompt": "## Word Length\n\nShort and long text responses can require a minimum number of words, a maximum number of words, or both.",
          "restartEnumeration": true
        },
        {
          "id": "word-length-short",
          "type": "shortText",
          "prompt": "Enter between two and five words.",
          "secondaryText": "This short text response uses minWordLength: 2 and maxWordLength: 5.",
          "placeholder": "2–5 words",
          "minWordLength": 2,
          "maxWordLength": 5
        },
        {
          "id": "word-length-long",
          "type": "longText",
          "prompt": "Enter between four and ten words.",
          "secondaryText": "This long text response uses minWordLength: 4 and maxWordLength: 10.",
          "placeholder": "4–10 words",
          "minWordLength": 4,
          "maxWordLength": 10
        },
        {
          "id": "built-in-validation-title",
          "type": "textOnly",
          "prompt": "## Built-in Validation\n\nShort text responses can use built-in validation to ensure the entered data is in the correct format.",
          "restartEnumeration": true
        },
        {
          "id": "built-in-validation-email",
          "type": "shortText",
          "prompt": "Enter an email address.",
          "secondaryText": "For example: test@revisit.dev.",
          "placeholder": "test@revisit.dev",
          "builtInValidation": "email"
        },
        {
          "id": "built-in-validation-phone-number",
          "type": "shortText",
          "prompt": "Enter an international phone number containing 7 to 15 digits.",
          "secondaryText": "It may begin with + and use hyphens between digits. For example: +800-0000-0000 or 8000000000.",
          "placeholder": "+800-0000-0000",
          "builtInValidation": "phoneNumber"
        },
        {
          "id": "built-in-validation-us-phone-number",
          "type": "shortText",
          "prompt": "Enter a 10-digit US phone number with two hyphens.",
          "secondaryText": "For example: 800-000-0000.",
          "placeholder": "800-000-0000",
          "builtInValidation": "usPhoneNumber"
        },
        {
          "id": "built-in-validation-url",
          "type": "shortText",
          "prompt": "Enter an HTTP or HTTPS URL.",
          "secondaryText": "For example: https://revisit.dev.",
          "placeholder": "https://revisit.dev",
          "builtInValidation": "url"
        },
        {
          "id": "date-time-response-title",
          "type": "textOnly",
          "prompt": "## Date and Time Responses\n\nDate and time responses use dedicated inputs and store their values as strings. The examples below demonstrate each date and time option separately.",
          "restartEnumeration": true
        },
        {
          "id": "date-placeholder-response",
          "type": "date",
          "options": "date",
          "prompt": "Date with a custom placeholder.",
          "secondaryText": "This response uses options: date and placeholder: Enter MM/DD/YYYY.",
          "placeholder": "Enter MM/DD/YYYY"
        },
        {
          "id": "date-min-response",
          "type": "date",
          "prompt": "Date with a minimum.",
          "secondaryText": "This response uses min: 06/01/2026.",
          "min": "06/01/2026"
        },
        {
          "id": "date-max-response",
          "type": "date",
          "prompt": "Date with a maximum.",
          "secondaryText": "This response uses max: 09/30/2026.",
          "max": "09/30/2026"
        },
        {
          "id": "date-range-response",
          "type": "date",
          "prompt": "Date within a range.",
          "secondaryText": "This response uses min: 06/01/2026 and max: 06/30/2026.",
          "min": "06/01/2026",
          "max": "06/30/2026"
        },
        {
          "id": "date-required-value-response",
          "type": "date",
          "prompt": "Date with a required value.",
          "secondaryText": "Enter exactly 06/24/2026. This response uses requiredValue.",
          "requiredValue": "06/24/2026"
        },
        {
          "id": "month-picker-response",
          "type": "date",
          "options": "month",
          "prompt": "Month picker.",
          "secondaryText": "This response uses options: month and stores its value as MM/YYYY.",
          "default": "06/2026",
          "min": "01/2026",
          "max": "12/2026"
        },
        {
          "id": "year-picker-response",
          "type": "date",
          "options": "year",
          "prompt": "Year picker.",
          "secondaryText": "This response uses options: year and stores its value as YYYY.",
          "default": "2026",
          "min": "2000",
          "max": "2030"
        },
        {
          "id": "time-standard-response",
          "type": "time",
          "prompt": "Time without seconds.",
          "secondaryText": "By default, time responses use the 24-hour HH:mm format."
        },
        {
          "id": "time-12-hour-response",
          "type": "time",
          "prompt": "Time in 12-hour format.",
          "secondaryText": "This response uses format: 12h and displays AM/PM while storing its value in 24-hour HH:mm format.",
          "format": "12h",
          "default": "14:28"
        },
        {
          "id": "time-min-response",
          "type": "time",
          "prompt": "Time with a minimum.",
          "secondaryText": "This response uses min: 09:00.",
          "min": "09:00"
        },
        {
          "id": "time-max-response",
          "type": "time",
          "prompt": "Time with a maximum.",
          "secondaryText": "This response uses max: 18:00.",
          "max": "18:00"
        },
        {
          "id": "time-range-response",
          "type": "time",
          "prompt": "Time within a range.",
          "secondaryText": "This response uses min: 09:00 and max: 18:00.",
          "min": "09:00",
          "max": "18:00"
        },
        {
          "id": "time-seconds-response",
          "type": "time",
          "prompt": "Time with seconds.",
          "secondaryText": "This response uses withSeconds: true and the HH:mm:ss format.",
          "withSeconds": true
        },
        {
          "id": "time-seconds-range-response",
          "type": "time",
          "prompt": "Time with seconds within a range.",
          "secondaryText": "This response combines withSeconds: true with min: 09:00:00 and max: 18:00:00.",
          "min": "09:00:00",
          "max": "18:00:00",
          "withSeconds": true
        },
        {
          "id": "time-required-value-response",
          "type": "time",
          "prompt": "Time with a required value.",
          "secondaryText": "Enter exactly 14:28. This response uses requiredValue.",
          "requiredValue": "14:28"
        }
      ]
    },
