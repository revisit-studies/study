{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.4/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Using Step Logic",
    "description": "This is a test of the step logic feature.",
    "version": "1.0.0",
    "authors": [
      "The reVISit Team"
    ],
    "date": "2026-02-23",
    "organizations": [
      "University of Utah",
      "WPI"
    ]
  },
  "uiConfig": {
    "contactEmail": "jwilburn@sci.utah.edu",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withSidebar": true,
    "withProgressBar": true
  },
  "baseComponents": {
    "trial": {
      "type": "questionnaire",
      "response": [
        {
          "id": "q1",
          "type": "radio",
          "prompt": "What is your favorite color?",
          "location": "belowStimulus",
          "options": [
            "Blue",
            "Red",
            "Green",
            "Yellow"
          ]
        },
        {
          "id": "q2",
          "type": "radio",
          "prompt": "What is your favorite animal?",
          "location": "belowStimulus",
          "options": [
            "Dog",
            "Cat",
            "Bird",
            "Fish"
          ]
        }
      ],
      "nextButtonLocation": "belowStimulus",
      "instruction": "Please answer the following questions...",
      "instructionLocation": "aboveStimulus"
    }
  },
  "components": {
    "trial1": {
      "baseComponent": "trial",
      "correctAnswer": [
        {
          "id": "q1",
          "answer": "Blue"
        },
        {
          "id": "q2",
          "answer": "Cat"
        }
      ]
    },
    "reactComponent": {
      "type": "react-component",
      "path": "test-step-logic/Example.tsx",
      "response": []
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "trial1",
      {
        "id": "loopingBlock",
        "order": "dynamic",
        "functionPath": "test-step-logic/func.ts",
        "parameters": {
          "name": "loopingBlock_1_"
        }
      },
      {
        "id": "loopingBlock2",
        "order": "dynamic",
        "functionPath": "test-step-logic/func.ts",
        "parameters": {
          "name": "loopingBlock2_2_"
        }
      },
      "trial1"
    ]
  }
}
