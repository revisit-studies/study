{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v3.0.0/src/parser/GlobalConfigSchema.json",
  "introductionPath": "introduction.md",
  "tabs": [
    {
      "label": "Snippets",
      "description": "Small, focused studies that each show off one feature of the reVISit platform.",
      "groups": [
        {
          "label": "Stimuli",
          "description": "Ways to show participants something: HTML, images, video, Vega specs, and React components."
        },
        {
          "label": "Data and Templating",
          "description": "Passing data into stimuli and filling content from templates."
        },
        {
          "label": "Responses and Feedback",
          "description": "Collecting answers, validating them, and training participants."
        },
        {
          "label": "Provenance Tracking",
          "description": "Recording interaction histories with Trrack so sessions can be replayed."
        },
        {
          "label": "Study Flow",
          "description": "Changing what participants see with dynamic and conditional blocks."
        },
        {
          "label": "Recording and Input Devices",
          "description": "Capturing screen recordings and input from devices like gamepads."
        },
        {
          "label": "Appearance",
          "description": "Theming and styling studies."
        },
        {
          "label": "Factors",
          "description": "Studies built with the factors configuration language, including its participant-level scheduling."
        }
      ]
    },
    {
      "label": "Example Studies",
      "description": "These are full studies that demonstrate the capabilities of the reVISit platform.",
      "groups": [
        {
          "label": "Perception and Literacy",
          "description": "Graphical perception experiments and literacy assessments."
        },
        {
          "label": "Interaction and Exploration",
          "description": "Studies of interactive selection, network exploration, and chat-based analysis."
        }
      ]
    },
    {
      "label": "Playground",
      "description": "Experimental studies that try out novel ideas and cutting-edge study designs, such as game-controller input, instrumented code editors, and LLM-powered chat."
    },
    {
      "label": "Tutorials",
      "description": "These studies are designed to help you learn how to use the reVISit platform."
    },
    {
      "label": "Tests",
      "description": "These studies exist for testing purposes.",
      "groups": [
        {
          "label": "Study Flow and Logic",
          "description": "Sequencing, randomization, skip and step logic, and timeouts."
        },
        {
          "label": "Responses and Validation",
          "description": "Response types, validation, scoring, and keyboard input."
        },
        {
          "label": "Global Store",
          "description": "Sharing state across trials with the global store."
        },
        {
          "label": "Platform and Configuration",
          "description": "Device rules, libraries, audio, and config parsing."
        }
      ]
    },
    {
      "label": "Libraries",
      "description": "Here you can see an example of every library that we publish.",
      "groups": [
        {
          "label": "Visualization Literacy and Numeracy",
          "description": "Assessments of how well participants read charts and reason with numbers."
        },
        {
          "label": "Visualization Aesthetics and Readability",
          "description": "Ratings of how attractive and readable a visualization is."
        },
        {
          "label": "Usability and User Experience",
          "description": "Standard questionnaires about a system's usability and experience."
        },
        {
          "label": "Workload and Affect",
          "description": "Measures of mental effort, workload, and emotional response."
        },
        {
          "label": "Participant Screening and Calibration",
          "description": "Background questions and checks to run before a study."
        },
        {
          "label": "Recording and Input",
          "description": "Capturing screens, webcams, and drawings."
        }
      ]
    }
  ],
